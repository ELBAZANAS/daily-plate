{
  "name": "daily-plate",
  "private": true,
  "version": "1.0.0",
  "description": "Daily Plate: gym training and nutrition tracker",
  "type": "module",
  "author": "EL BAZ ANAS (https://github.com/ELBAZANAS)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ELBAZANAS/daily-plate.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "media": "node scripts/get-exercise-media.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "package:win": "node scripts/build.mjs && electron-builder --win dir"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.9",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "com.dailyplate.app",
    "productName": "Daily Plate",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "launcher/DailyPlate.ico",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "launcher/DailyPlate.ico",
      "signAndEditExecutable": false
    }
  }
}
